{
  // JB-Router web deployer: a small Worker that serves the install page and proxies the
  // visitor's Cloudflare API calls (api.cloudflare.com has no CORS, browsers cannot call it).
  "name": "jb-deployer",
  "main": "src/index.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./static",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  "vars": {
    "DEPLOYER_VERSION": "1.0.0"
  }
}
