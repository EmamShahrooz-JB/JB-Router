{
  "name": "jb-router-local-regression",
  "main": "tests/fixtures/actor-routing.js",
  "compatibility_date": "2025-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "DATA_DIR": "/tmp/.9router",
    "AUTH_COOKIE_SECURE": "false",
    "INITIAL_PASSWORD": "local-regression-only-not-production",
    "JWT_SECRET": "local-regression-jwt-key-not-for-production-0123456789"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TEST_ACTORS",
        "class_name": "RouterDatabase"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-durable-sqlite",
      "new_sqlite_classes": [
        "RouterDatabase"
      ]
    }
  ]
}
